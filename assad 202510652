import java.util.ArrayList;
import java.util.Scanner;

public class Main {
    public static void main(String[] args) {
        Scanner input = new Scanner(System.in);

        final int correctPin = 1234;
        int attempts = 0;
        boolean loggedIn = false;

        // Ask for the PIN, allowing up to three attempts.
        while (attempts < 3 && !loggedIn) {
            System.out.print("Enter your PIN: ");

            if (input.hasNextInt()) {
                int enteredPin = input.nextInt();

                if (enteredPin == correctPin) {
                    loggedIn = true;
                } else {
                    attempts++;
                    System.out.println("Incorrect PIN.");
                }
            } else {
                input.next(); // Discard invalid input
                attempts++;
                System.out.println("Please enter numbers only.");
            }
        }

        if (!loggedIn) {
            System.out.println("Too many incorrect attempts. Goodbye.");
            input.close();
            return;
        }

        double balance = 0.0;
        ArrayList<String> transactions = new ArrayList<>();
        boolean running = true;

        while (running) {
            System.out.println("\n--- ATM Menu ---");
            System.out.println("1. Check balance");
            System.out.println("2. Deposit");
            System.out.println("3. Withdraw");
            System.out.println("4. View transactions");
            System.out.println("5. Exit");
            System.out.print("Choose an option: ");

            if (!input.hasNextInt()) {
                input.next();
                System.out.println("Please enter a number from 1 to 5.");
                continue;
            }

            int choice = input.nextInt();

            switch (choice) {
                case 1:
                    System.out.printf("Your balance is: $%.2f%n", balance);
                    break;

                case 2:
                    System.out.print("Enter deposit amount: $");
                    if (input.hasNextDouble()) {
                        double deposit = input.nextDouble();

                        if (deposit > 0) {
                            balance += deposit;
                            transactions.add(String.format("Deposited $%.2f", deposit));
                            System.out.println("Deposit successful.");
                        } else {
                            System.out.println("Amount must be greater than zero.");
                        }
                    } else {
                        input.next();
                        System.out.println("Please enter a valid amount.");
                    }
                    break;

                case 3:
                    System.out.print("Enter withdrawal amount: $");
                    if (input.hasNextDouble()) {
                        double withdrawal = input.nextDouble();

                        if (withdrawal <= 0) {
                            System.out.println("Amount must be greater than zero.");
                        } else if (withdrawal > balance) {
                            System.out.println("Insufficient funds.");
                        } else {
                            balance -= withdrawal;
                            transactions.add(String.format("Withdrew $%.2f", withdrawal));
                            System.out.println("Withdrawal successful.");
                        }
                    } else {
                        input.next();
                        System.out.println("Please enter a valid amount.");
                    }
                    break;

                case 4:
                    if (transactions.isEmpty()) {
                        System.out.println("No transactions yet.");
                    } else {
                        System.out.println("--- Transaction History ---");
                        for (String transaction : transactions) {
                            System.out.println(transaction);
                        }
                    }
                    break;

                case 5:
                    running = false;
                    System.out.println("Thank you for using the ATM.");
                    break;

                default:
                    System.out.println("Please choose an option from 1 to 5.");
            }
        }

        input.close();
    }
}
